# Copy this file to ".env" in the repo root. Every value is optional.
# NEVER commit your real ".env" (it is in .gitignore).

# --- LLM ---
# mock = runs with no API key. Other options: anthropic | gemini | openai
LLM_PROVIDER=mock
# Model name from your provider's docs (only needed when LLM_PROVIDER is not mock)
LLM_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Telegram (leave empty for mock mode) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Behaviour ---
# Seconds to wait for a guardian to acknowledge before escalating to the backup
ACK_TIMEOUT_S=60
# Illustrative number used for the "estimated money saved" stat
AVG_LOSS_PREVENTED_INR=25000
# Saved raw text / transcripts are deleted after this many hours
DATA_TTL_HOURS=24
FRONTEND_ORIGIN=http://localhost:3000
